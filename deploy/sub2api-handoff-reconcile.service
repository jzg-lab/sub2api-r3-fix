[Unit]
Description=Recover the selected Sub2API slot or interrupted handoff
After=docker.service nginx.service
Requires=docker.service nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sub2api-control/tools/managed_deploy.py reconcile --config /opt/sub2api-control/config.json
TimeoutStartSec=360
StandardOutput=append:/opt/sub2api-control/reconcile.log
StandardError=append:/opt/sub2api-control/reconcile.log
